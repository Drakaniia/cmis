{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ],
  "linter": {
    "rules": {
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": [
              "AppleDatePicker",
              "Checkbox",
              "QuantityStepper"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/desktop/src/components/mode-toggle.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/components/theme-provider.tsx",
        "packages/ui/src/lib/utils.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/lib/tauri.ts",
        "packages/ui/src/components/message-scroller.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExportedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/env/src/web.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/input-group.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off",
            "noNoninteractiveElementInteractions": "off"
          },
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/label.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      // These views use ARIA table/splitter semantics on purpose. Their rows
      // are virtualized: each row is an absolutely positioned wrapper inside
      // the scroll container, so it cannot live in a real <table> without
      // giving up virtualization (and the layout's CSS-grid column widths).
      // inventory-page's drag handle is a window splitter, where
      // role="separator" + aria-valuenow is the required pattern and <hr>
      // cannot carry the value. expiry-timeline-widget's bars are SVG <g>
      // elements, which have no semantic HTML equivalent.
      "includes": [
        "apps/desktop/src/features/admin/analytics/components/expiry-timeline-widget.tsx",
        "apps/desktop/src/features/inventory/components/expiry-list.tsx",
        "apps/desktop/src/features/inventory/components/inventory-list.tsx",
        "apps/desktop/src/features/inventory/components/inventory-page.tsx",
        "apps/desktop/src/features/inventory/components/low-stock-list.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useAriaPropsSupportedByRole": "off",
            "useFocusableInteractive": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/features/inventory/components/expiry-list.tsx",
        "apps/desktop/src/features/inventory/components/item-edit-panel.tsx",
        "apps/desktop/src/features/inventory/components/item-history-panel.tsx",
        "apps/desktop/src/features/inventory/components/low-stock-list.tsx",
        "apps/desktop/src/features/inventory/components/stock-detail-menu.tsx",
        "apps/desktop/src/features/inventory/components/stock-detail-modal.tsx",
        "apps/desktop/src/routes/admin.inventory.expiry.tsx",
        "apps/desktop/src/routes/admin.inventory.low-stock.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/features/inventory/components/category-picker.tsx",
        "apps/desktop/src/features/inventory/components/stock-detail-modal.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/features/inventory/components/category-picker.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noLeakedRender": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/features/inventory/components/stock-detail-modal.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noNestedTernary": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/features/inventory/components/item-edit-panel.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/features/inventory/components/item-history-panel.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/features/inventory/data/strength-backfill.ts",
        "apps/desktop/src/features/inventory/components/stock-detail-modal.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/desktop/src/features/inventory/data/strength-backfill.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noShadowRestrictedNames": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/desktop/src/lib/preview-db.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noRedundantDefaultExport": "off"
          }
        }
      }
    }
  ]
}
